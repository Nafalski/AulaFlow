# ─────────────────────────────────────────────────────────────────────────────
# AulaFlow — variáveis de ambiente
#
# 1. Copie este ficheiro para `.env.local`
# 2. Preencha com os valores do seu projeto Supabase
# 3. NUNCA faça commit do `.env.local` (já está no .gitignore)
#
# Onde encontrar: painel Supabase → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obrigatório) ───────────────────────────────────────────────────

# URL do projeto. Enviada ao browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Chave pública ("anon" / "publishable"). Enviada ao browser — é suposto ser
# pública. A segurança dos dados NÃO depende de a manter secreta: depende das
# políticas de Row Level Security, que estão ativas em todas as tabelas.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Supabase — service role (opcional nesta fase) ────────────────────────────

# ATENÇÃO: esta chave IGNORA COMPLETAMENTE o Row Level Security.
# - Nunca prefixar com NEXT_PUBLIC_
# - Nunca importar em Client Components
# - Usar apenas em tarefas agendadas (lembretes, envio de emails)
# Necessária a partir da Fase 8.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Aplicação ────────────────────────────────────────────────────────────────

# URL base pública. Usada nos links de confirmação de email e recuperação
# de palavra-passe. Em produção: https://o-seu-dominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Testes E2E remotos de desenvolvimento ───────────────────────────────────

# Usadas apenas pelos scripts locais:
#   npm run db:setup:e2e -- --confirm-development
#   npm run db:verify:auth -- --confirm-development
#
# Não use dados pessoais reais. Não reutilize senhas reais. Estes valores não
# são necessários para o arranque normal da aplicação.
AULAFLOW_SUPABASE_PROJECT_REF="seu_project_ref_de_desenvolvimento"
E2E_RUN_ID="default"
E2E_TEACHER_EMAIL="e2e_aulaflow_professor_a@example.com"
E2E_TEACHER_PASSWORD=""
E2E_STUDENT_EMAIL="e2e_aulaflow_aluno_a@example.com"
E2E_STUDENT_PASSWORD=""
E2E_TEACHER_B_EMAIL="e2e_aulaflow_professor_b@example.com"
E2E_TEACHER_B_PASSWORD=""
E2E_STUDENT_B_EMAIL="e2e_aulaflow_aluno_b@example.com"
E2E_STUDENT_B_PASSWORD=""
E2E_ADMIN_EMAIL="e2e_aulaflow_admin@example.com"
E2E_ADMIN_PASSWORD=""
E2E_BLOCKED_EMAIL="e2e_aulaflow_bloqueado@example.com"
E2E_BLOCKED_PASSWORD=""

# ── WhatsApp (fora do âmbito do MVP) ─────────────────────────────────────────
# Deliberadamente não implementado. O enum `notification_channel` já prevê
# este canal, para que a integração futura não exija alterações ao domínio.
