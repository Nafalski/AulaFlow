# ─────────────────────────────────────────────────────────────────────────────
# AulaFlow — variáveis de ambiente
#
# 1. Copie este ficheiro para `.env.local`
# 2. Preencha com os valores do seu projeto Supabase
# 3. NUNCA faça commit do `.env.local` (já está no .gitignore)
#
# Onde encontrar: painel Supabase → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obrigatório) ───────────────────────────────────────────────────

# URL do projeto. Enviada ao browser.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Chave pública ("anon" / "publishable"). Enviada ao browser — é suposto ser
# pública. A segurança dos dados NÃO depende de a manter secreta: depende das
# políticas de Row Level Security, que estão ativas em todas as tabelas.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Supabase — service role (scripts locais, nunca no browser) ──────────────

# ATENÇÃO: esta chave IGNORA COMPLETAMENTE o Row Level Security.
# - Nunca prefixar com NEXT_PUBLIC_
# - Nunca importar em Client Components
# - Usada localmente por db:setup:e2e e db:verify:auth
# - O runtime Next atual não precisa dela
# - A Edge Function recebe a sua própria cópia injetada pelo Supabase
SUPABASE_SERVICE_ROLE_KEY=""

# ── Aplicação ────────────────────────────────────────────────────────────────

# URL base pública. Usada nos links de confirmação de email e recuperação
# de palavra-passe. Em produção é obrigatória e não tem fallback para localhost:
# https://o-seu-dominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Testes E2E remotos de desenvolvimento ───────────────────────────────────

# Usadas apenas pelos scripts locais:
#   npm run db:setup:e2e -- --confirm-development
#   npm run db:verify:auth -- --confirm-development
#
# Não use dados pessoais reais. Não reutilize senhas reais. Estes valores não
# são necessários para o arranque normal da aplicação.
AULAFLOW_SUPABASE_PROJECT_REF="seu_project_ref_de_desenvolvimento"
E2E_RUN_ID="default"
E2E_TEACHER_EMAIL="e2e_aulaflow_professor_a@example.com"
E2E_TEACHER_PASSWORD=""
E2E_STUDENT_EMAIL="e2e_aulaflow_aluno_a@example.com"
E2E_STUDENT_PASSWORD=""
E2E_TEACHER_B_EMAIL="e2e_aulaflow_professor_b@example.com"
E2E_TEACHER_B_PASSWORD=""
E2E_STUDENT_B_EMAIL="e2e_aulaflow_aluno_b@example.com"
E2E_STUDENT_B_PASSWORD=""
E2E_ADMIN_EMAIL="e2e_aulaflow_admin@example.com"
E2E_ADMIN_PASSWORD=""
E2E_BLOCKED_EMAIL="e2e_aulaflow_bloqueado@example.com"
E2E_BLOCKED_PASSWORD=""

# ── Worker de email da Etapa 8C ─────────────────────────────────────────────
#
# ATENÇÃO: estes valores NÃO pertencem a `.env.local`. Vivem como SEGREDOS DA
# EDGE FUNCTION no projeto Supabase (`supabase secrets set`), e o URL e o token
# vivem também no Vault do projeto, para o `pg_cron` os poder ler. Ficam aqui
# documentados apenas para se saber que existem e o que fazem.
#
# Enquanto não estiverem configurados, o worker responde 503 e não reclama nada:
# as entregas ficam pendentes no outbox em vez de serem dadas como falhadas.
#
#   AULAFLOW_EMAIL_WORKER_TOKEN   Segredo comparado com o cabeçalho
#                                 `x-aulaflow-worker-token`. Sem ele, a função
#                                 recusa todos os pedidos.
#   RESEND_API_KEY                Chave do fornecedor de email.
#   AULAFLOW_EMAIL_FROM           Remetente verificado no fornecedor.
#   AULAFLOW_SITE_URL             Base dos links do email. Em produção tem de ser
#                                 o domínio real: um `localhost` num email
#                                 enviado é um link partido.
#
# E no Vault do projeto, lidos pelo `pg_cron` em cada execução:
#
#   aulaflow_email_worker_url     URL da Edge Function `notification-email-worker`
#   aulaflow_email_worker_token   O mesmo valor de AULAFLOW_EMAIL_WORKER_TOKEN
#
# Nenhum destes valores entra numa migração, num script ou no repositório.

# ── WhatsApp (fora do âmbito do MVP) ─────────────────────────────────────────
# Deliberadamente não implementado. O enum `notification_channel` já prevê
# este canal, para que a integração futura não exija alterações ao domínio.
